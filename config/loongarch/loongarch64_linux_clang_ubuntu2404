[binaries]
c = ['ccache', 'clang-20']
cpp = ['ccache', 'clang++-20']
ar = 'llvm-ar-20'
strip = 'llvm-strip-20'
llvm-config = 'llvm-config-20'
pcap-config = 'llvm-config-20'

[host_machine]
system = 'linux'
cpu_family = 'loongarch64'
cpu = 'loongarch64'
endian = 'little'

[properties]
platform = 'generic'
c_args = ['-target', 'loongarch64-linux-gnu', '--sysroot', '/usr/loongarch64-linux-gnu']
c_link_args = ['-target', 'loongarch64-linux-gnu', '--sysroot', '/usr/loongarch64-linux-gnu', '-fuse-ld=lld', '--gcc-toolchain=/usr']
cpp_args = ['-target', 'loongarch64-linux-gnu', '--sysroot', '/usr/loongarch64-linux-gnu']
cpp_link_args = ['-target', 'loongarch64-linux-gnu', '--sysroot', '/usr/loongarch64-linux-gnu', '-fuse-ld=lld', '--gcc-toolchain=/usr']
